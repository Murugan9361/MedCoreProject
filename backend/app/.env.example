# Never commit a real value in this file. Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-48-byte-secret

# Database Configuration (supports both MySQL and PostgreSQL):
# MySQL example (default port 3306):
DATABASE_URL=mysql+pymysql://root:kandha@localhost:3306/medcore

# PostgreSQL example (default port 5432):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/medcore

JWT_ISSUER=medcore-api
JWT_AUDIENCE=medcore-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# A comma-separated allow-list. Leave blank until a frontend is deployed.
CORS_ORIGINS=
# Required in production; comma-separated host names only.
TRUSTED_HOSTS=localhost,127.0.0.1
